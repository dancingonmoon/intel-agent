# Copy to ~/.config/intel-agent/env and chmod 600.
# Only the variables you actually use need to be set.

# LLM via the Anthropic Messages API (used when llm.provider is auto/anthropic
# and the claude CLI is unavailable).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Brave Search API (optional search engine).
# BRAVE_SEARCH_API_KEY=

# SMTP password for delivery.email.mode=smtp.
# SMTP_PASSWORD=

# Command that receives one alert message as its argument.
# INTEL_ALERT_CMD=/home/you/bin/send-alert

# Optional overrides
# INTEL_REPORTS_DIR=/home/you/reports/intel
# INTEL_LLM_MODEL=claude-sonnet-5-5
